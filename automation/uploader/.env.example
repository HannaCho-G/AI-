# 실제 값은 이 파일을 복사한 automation/uploader/.env 에만 채운다.
# .env는 .gitignore로 제외되어 있어 저장소에 절대 올라가지 않는다.
#
# 비밀번호를 여기 채우는 것보다, 가능하면 각 플랫폼에 한 번 수동 로그인해서
# automation/uploader/.auth/<platform>.json (Playwright storageState)로 세션을
# 저장해두는 방식을 우선한다 (README.md "최초 로그인" 절차 참고).
# 아래 변수들은 세션 재사용이 불가능하거나 2차 인증 자동 입력이 필요한 경우에만 쓴다.

# Amazon KDP
KDP_EMAIL=
KDP_PASSWORD=

# Gumroad
GUMROAD_EMAIL=
GUMROAD_PASSWORD=

# Digital24Store
DIGITAL24STORE_EMAIL=
DIGITAL24STORE_PASSWORD=

# Whop
WHOP_EMAIL=
WHOP_PASSWORD=

# Etsy
ETSY_EMAIL=
ETSY_PASSWORD=

# eBay
EBAY_EMAIL=
EBAY_PASSWORD=
