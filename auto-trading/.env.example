# 이 파일을 복사해서 .env로 만들고 값을 채우세요.
# .env는 절대 git에 커밋하지 마세요 (API 키가 들어갑니다).

# 업비트 Open API 키 (마이페이지 > Open API 관리에서 발급)
# 비워두면 자동으로 모의(페이퍼) 트레이딩 모드로 실행됩니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 시드(원금). 출금 후에도 항상 이 금액을 기준으로 다시 굴립니다.
TRADING_CAPITAL_KRW=50000

# 평가자산이 초기자본의 이 비율 밑으로 떨어지면 전량 취소+매도 후 정지
# 0.85 = 15% 손실 시 정지. 소액 테스트 중에는 더 타이트하게(0.9 등) 잡아도 됩니다.
STOP_LOSS_PCT=0.85

# 시드의 이 배수에 도달하면 시드금액만큼 출금 트리거 (기본 2.0 = 5만원->10만원)
# 도달해도 봇은 정지하지 않고, 남은 금액으로 계속 매매합니다.
WITHDRAW_MULTIPLE=2.0

# true로 하면 목표 도달 시 실제 업비트 출금 API를 자동으로 호출합니다.
# 반드시 사전에: (1) 업비트 앱/웹에서 출금계좌 등록 (2) API 키에 "출금하기"
# 권한 + 허용 IP 설정이 되어 있어야 성공합니다. 이 두 가지는 API로 대신할 수
# 없고 업비트 사이트에서 직접 해야 합니다.
# false(기본값)면 실제 출금은 하지 않고 알림만 하며, 알림을 보고 앱에서
# 직접 출금한 뒤 `python grid_engine.py --confirm-withdrawal`을 실행하면 됩니다.
AUTO_WITHDRAW_ENABLED=false

# 출금 알림을 반복할 간격(초). 기본 3600초(1시간)마다 한 번만 알림.
WITHDRAW_ALERT_COOLDOWN_SEC=3600

# 그리드 단계 수. 자본이 적을수록 낮게 (레벨당 금액이 5,000원 밑이면 실행이 거부됩니다)
GRID_LEVELS=4

# 실거래는 15분봉(TIMEFRAME)을 쓰지만, `--backtest --years 5` 처럼 긴 기간을
# 백테스트할 때는 이 타임프레임을 씁니다. 15분봉으로 수년치를 받으면 캔들이
# 너무 많아져 비현실적이라 기본은 일봉입니다.
BACKTEST_TIMEFRAME=1d
